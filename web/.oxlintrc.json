{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "jsx-a11y"],
  "env": { "browser": true, "es2022": true },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // Not part of any category, so it must be named explicitly.
    "react/rules-of-hooks": "error",
    // tsconfig sets "jsx": "react-jsx" (the automatic runtime), so JSX never
    // expands to React.createElement and React need not be in scope.
    "react/react-in-jsx-scope": "off",
    // DataTable columns, disclosures, and action menus are explicit render
    // props. They do not define stateful child component types.
    "react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
    // Bundled stylesheets are imported for their side effect and have
    // nothing to bind (src/main.tsx pulls in styles.css and uPlot's CSS).
    "import/no-unassigned-import": "off",
    // The dashboard uses role="status" for live regions, role="group" for
    // toolbars and role="img" for inline SVG -- all correct ARIA. The tags
    // this rule prefers (output, fieldset, img) carry different semantics
    // and their own UA styling, so swapping them would be a regression.
    "jsx-a11y/prefer-tag-over-role": "off",
    // The Section 508 gate (docs/accessibility.md, epic #107): every other
    // jsx-a11y rule at error severity. Categories only cover the plugin's
    // correctness subset and oxlint has no per-plugin severity switch, so
    // the full set is named explicitly. Existing per-line suppressions are
    // inventoried by web/test/a11y-source.test.mjs; do not add new ones.
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "overrides": [
    {
      "files": ["tools/**/*.mjs"],
      "env": { "browser": false, "node": true }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "src/assets/mapGeo.ts"]
}
