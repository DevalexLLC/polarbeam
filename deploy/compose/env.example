# Copy to .env next to docker-compose.yml and edit. Compose reads it
# automatically; every value here is required reading before first start.

# TimescaleDB password (required — compose refuses to start without it).
POLARBEAM_DB_PASSWORD=

# Image tag to run, e.g. v1.0.0. Pin this; ":latest" is only a fallback.
POLARBEAM_VERSION=

# SNI that routes agents to the gRPC listener. MUST match the server
# config's listen.grpc_hostname (and the DNS name agents dial).
POLARBEAM_GRPC_SNI=grpc.polarbeam.local
